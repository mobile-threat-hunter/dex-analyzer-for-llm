    "ACCOUNTS",
    "BLUETOOTH",
    "CALENDAR",
    "CALL_LOG",
    "CAMERA",
    "CONTACTS",
    "CRYPTO",
    "DYNAMIC_LOAD",
    "LOCATION",
    "MICROPHONE",
    "NATIVE_CODE",
